# Cloudflare redirects (SPEC §4).
#
# The ten 301s below follow the table in SPEC §4, amended 2 Sep 2026: the
# TEFL affiliate page was dropped entirely (stale — Barry), so its legacy
# path now joins the six retired "English courses in the UK" pages
# (capture §6) in pointing at /. Sending retired pages to / consolidates
# any residual link equity. No catch-all: anything unlisted falls through
# to the custom 404 (app/not-found.tsx).
#
# /privacy keeps the old path, so it needs no redirect.
#
# /gdpr-consent is deliberately left dead. It already 404s on the live site;
# SPEC §4 says leave it dead and keep it out of the sitemap, and the custom
# 404 page handles it. Do not add a line for it.

/recruitment                          /for-employers   301
/teaching-jobs                        /jobs            301
/contact-alt                          /contact         301
/tefl-tesol-courses                   /                301
/accommodation                        /                301
/agents                               /                301
/english-language-courses-in-the-uk   /                301
/faq                                  /                301
/language-course-pricing              /                301
/things-to-do-in-littlehampton        /                301

# The old site also answers on .php forms of its paths. Each line below was
# checked on the live site on 24 Oct 2026 and returned 200 (an unknown .php
# path returns 404 there), so these may be indexed or linked. They go
# straight to the final destination, not via the extensionless path.
# /contact.php, /gdpr-consent.php and the new site's own paths with .php
# returned 404, so they have no line.

/index.php                                /                301
/recruitment.php                          /for-employers   301
/teaching-jobs.php                        /jobs            301
/contact-alt.php                          /contact         301
/privacy.php                              /privacy         301
/tefl-tesol-courses.php                   /                301
/accommodation.php                        /                301
/agents.php                               /                301
/english-language-courses-in-the-uk.php   /                301
/faq.php                                  /                301
/language-course-pricing.php              /                301
/things-to-do-in-littlehampton.php        /                301

# TinaCMS admin directory index (SPEC §10). Tina builds the admin to
# /admin/index.html; Cloudflare usually serves the directory index itself,
# and this 200 rewrite guarantees /admin resolves rather than 404ing.
/admin  /admin/index.html  200
