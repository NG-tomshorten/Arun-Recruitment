{
  "name": "arun-recruitment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "dev:next": "next dev",
    "build": "npm run check:contrast && rm -rf .next tina/__generated__/.cache && tinacms build --local --skip-cloud-checks --no-client-build-cache -c \"NODE_ENV=production next build\"",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "bash scripts/verify-build.sh",
    "test": "node worker/test-worker.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "qs": ">=6.15.4"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tinacms": "^3.12.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tinacms/cli": "^2.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
