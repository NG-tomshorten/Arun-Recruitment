{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run check:contrast:*)",
      "Bash(npm ci)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(sips:*)",
      "WebFetch(domain:tina.io)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:schema.org)",
      "WebFetch(domain:arunlanguagetraining.com)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm audit fix:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
